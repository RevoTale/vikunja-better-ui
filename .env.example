# Backend transport; HTTP is supported on trusted internal networks, including production.
APP_VIKUNJA_URL=https://vikunja.example.com
# Public native base URL for task links and stored image references; defaults to APP_VIKUNJA_URL.
# Required with HTTPS in production when transport uses HTTP (e.g. http://vikunja:3456).
APP_VIKUNJA_PUBLIC_URL=
# Required permissions: other:user; projects:read_all;
# tasks:create,read_all,read_one,update,delete; labels:create,read_all;
# tasks_labels:create,read_all; tasks_relations:create,delete. See README.md for details.
APP_VIKUNJA_API_TOKEN=replace-with-a-scoped-api-token
APP_AUTH_USERNAME=replace-with-app-username
APP_AUTH_PASSWORD=replace-with-a-strong-app-password
APP_SESSION_SECRET=replace-with-base64-encoded-32-byte-random-secret
APP_HTTP_ADDR=:8080
APP_LOG_LEVEL=info
# UI clock format: 24h (default) or 12h (AM/PM). Restart the service and reload.
APP_TIME_FORMAT=24h
# Canonical public origin and explicit SEO opt-in. HTTPS is required outside development.
# Leave empty to keep the root page out of search indexes and the sitemap.
APP_PUBLIC_URL=
# Anonymous fourteen-day completion counts at /activity. Signed-in access is always enabled.
APP_PUBLIC_ACTIVITY_ENABLED=false
# Anonymous weekly all-history page. Signed-in access is always enabled; one-hour aggregate cache.
PUBLIC_ALL_TIME_ACTIVITY=false
APP_ENV=production
APP_ALLOWED_ORIGIN=https://tasks.example.com
