APP_VIKUNJA_URL=https://vikunja.example.com
# Required permissions: other:user; projects:read_all;
# tasks:create,read_all,read_one,update,delete; labels:create,read_all;
# tasks_labels:create,read_all. See README.md for details.
APP_VIKUNJA_API_TOKEN=replace-with-a-scoped-api-token
APP_AUTH_USERNAME=replace-with-app-username
APP_AUTH_PASSWORD=replace-with-a-strong-app-password
APP_SESSION_SECRET=replace-with-base64-encoded-32-byte-random-secret
APP_HTTP_ADDR=:8080
APP_LOG_LEVEL=info
APP_ENV=production
APP_ALLOWED_ORIGIN=https://tasks.example.com
