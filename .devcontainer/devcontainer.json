{
	"name": "Vikunja Better UI",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"features": {
		"ghcr.io/devcontainers/features/go:1": {
			"version": "1.27.0"
		},
		"ghcr.io/devcontainers/features/node:2": {
			"version": "26.7.0",
			"pnpmVersion": "none"
		},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"moby": false
		}
	},
	"forwardPorts": [4180],
	"portsAttributes": {
		"4180": {
			"label": "Better Vikunja E2E demo",
			"onAutoForward": "notify"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"biomejs.biome",
				"task.vscode-task"
			]
		}
	},
	"postCreateCommand": "go mod download && go -C tools install tool && pnpm --dir frontend install --frozen-lockfile && pnpm --dir frontend exec playwright install --with-deps chromium webkit"
}
