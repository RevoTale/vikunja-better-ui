{
	"name": "Vikunja Better UI",
	"image": "mcr.microsoft.com/devcontainers/base:trixie@sha256:025b74bb5f7ac53edd77e01aa7188c359aab100e23a2f6220bde50bbb9fd31dd",
	"features": {
		"ghcr.io/devcontainers/features/go:1": {
			"version": "1.26.6",
			"golangciLintVersion": "2.12.2"
		},
		"ghcr.io/devcontainers/features/node:2": {
			"version": "26.7.0",
			"pnpmVersion": "11.22.0"
		},
		"ghcr.io/eitsupi/devcontainer-features/go-task:1": {
			"version": "3.52.0"
		},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"moby": false
		}
	},
	"forwardPorts": [4180],
	"portsAttributes": {
		"4180": {
			"label": "Better Vikunja E2E demo",
			"onAutoForward": "notify"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"biomejs.biome",
				"task.vscode-task"
			]
		}
	},
	"postCreateCommand": "pnpm --dir frontend install --frozen-lockfile && pnpm --dir frontend exec playwright install --with-deps chromium && go mod download"
}
