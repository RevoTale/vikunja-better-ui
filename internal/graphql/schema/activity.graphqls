extend type Query {
  "Authenticated current fixed-window completion counts. Anonymous clients use /public/v1/activity."
  publicActivity: PublicActivity
  "Authenticated current weekly all-history aggregates. Anonymous clients use the bounded public REST snapshot."
  publicAllTimeActivity: PublicAllTimeActivity
}

type PublicAllTimeActivity {
  weeks: [ActivityWeek!]!
  priorities: [ActivityPriority!]!
  total: Int!
  timezone: String!
  generatedAt: DateTime!
  refreshAt: DateTime!
}

type ActivityWeek {
  "Monday calendar date in the token owner's timezone; the current week is partial."
  date: String!
  count: Int!
  completedWithDeadline: Int!
  completedOnTime: Int!
  "Nonempty priority cohorts for client-side filtering without extra upstream reads."
  priorities: [ActivityPriorityTimeliness!]!
}

type ActivityPriorityTimeliness {
  priority: TaskPriority!
  count: Int!
  completedWithDeadline: Int!
  completedOnTime: Int!
}

type PublicActivity {
  days: [ActivityDay!]!
  priorities: [ActivityPriority!]!
  total: Int!
  timezone: String!
  generatedAt: DateTime!
  refreshAt: DateTime!
}

type ActivityDay {
  date: String!
  count: Int!
  "Completed tasks with a stored deadline, grouped by completion day."
  completedWithDeadline: Int!
  "Eligible completions at or before their stored deadline."
  completedOnTime: Int!
}

type ActivityPriority {
  priority: TaskPriority!
  count: Int!
}
